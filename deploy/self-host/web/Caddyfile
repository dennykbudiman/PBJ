# Axle web server: serves the app and passes database/login/file requests to Supabase.
# Settings come from the stack's .env (written by axle.sh), so this file normally needs no edits.
#   AXLE_SITE_ADDRESS  e.g. axle.example.co.id, 192.168.1.20, or http://192.168.1.20 (no padlock)
#   AXLE_TLS_MODE      auto | internal | off
#   AXLE_ACME_EMAIL    contact email for Let's Encrypt (auto mode)
#   AXLE_DEFAULT_SNI   certificate name used when a browser opens the site by IP address

{
	admin off
	skip_install_trust
	default_sni {$AXLE_DEFAULT_SNI}
}

(tls_auto) {
	tls {$AXLE_ACME_EMAIL}
}

(tls_internal) {
	tls internal
}

(tls_off) {
}

{$AXLE_SITE_ADDRESS} {
	import tls_{$AXLE_TLS_MODE}

	# Supabase APIs (same paths as on supabase.co, so the app needs no changes)
	@api path /auth/v1/* /rest/v1/* /graphql/v1 /graphql/v1/* /realtime/v1/* /storage/v1/* /functions/v1/*
	handle @api {
		reverse_proxy {$AXLE_API_UPSTREAM:api-gw:8000}
	}

	# Built files have a fingerprint in their name: cache for a year. A missing one is a plain 404
	# (not index.html), so a tab left open across an update fails cleanly and reloads.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	# The app itself: index.html for every page address (client-side routing)
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		encode zstd gzip
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}
